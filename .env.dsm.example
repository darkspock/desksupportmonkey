# DeskSupportMonkey — Brand Environment
# Copy to .env.dsm and adjust values

# Brand Identity (all runtime — served via /api/v1/brand)
BRAND_NAME=DeskSupportMonkey
BRAND_SHORT_NAME=DS Monkey
BRAND_SLUG=dsm
BRAND_LOGO_EXT=png
BRAND_FAVICON_EXT=png
BRAND_LOGIN_EXT=png

# Database (unique per brand)
POSTGRES_DB=dsm_dev

# All other settings — copy from .env.example or inherit from base .env
