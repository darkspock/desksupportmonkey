# DSM Control — Brand Environment
# Copy to .env.dsmcontrol and adjust values

# Brand Identity (all runtime — served via /api/v1/brand)
BRAND_NAME=DSM Control
BRAND_SHORT_NAME=DSM Control
BRAND_SLUG=dsmcontrol
BRAND_LOGO_EXT=svg
BRAND_FAVICON_EXT=svg
BRAND_LOGIN_EXT=svg

# Database (unique per brand)
POSTGRES_DB=dsmcontrol_dev

# All other settings — copy from .env.example or inherit from base .env
