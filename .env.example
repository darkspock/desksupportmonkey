# DeskSupportMonkey - Environment Variables
# Copy this file to .env and adjust values as needed

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dsm_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5444

# Environment
ENVIRONMENT=development
DEBUG=True

# Auth
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
MAGIC_LINK_EXPIRE_HOURS=24

# Celery / Redis (port 6399 maps to container's 6379)
CELERY_BROKER_URL=redis://localhost:6399/0
CELERY_RESULT_BACKEND=redis://localhost:6399/0
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

# SMTP (Mailpit for development)
SMTP_HOST=localhost
SMTP_PORT=1028
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@desksupportmonkey.com
SMTP_USE_TLS=False

# S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9002
S3_REPORTS_BUCKET=dsm-reports
S3_SIGNED_URL_EXPIRY=3600

# Monitoring
# SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>

# Super Admin (auto-created on startup if set)
# SUPER_ADMIN_EMAIL=admin@desksupportmonkey.com

# Frontend
FRONTEND_URL=http://localhost:5173
# VITE_SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project-id>

# AI (Equipment auto-assignment tie-breaker)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# OAuth (leave empty to disable the provider)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# MICROSOFT_CLIENT_ID=your-microsoft-app-client-id
# MICROSOFT_TENANT_ID=common

# MCP Server (AI assistant integration)
# Set MCP_ENABLED=true to mount the SSE endpoint
# MCP_ENABLED=false
# MCP_SSE_PATH=/mcp

# ---------------------------------------------------------------------------
# Stripe Billing
# ---------------------------------------------------------------------------
# Leave all keys empty (or set OPEN_SOURCE_MODE=true) to run without billing.
# Every new company gets a 15-day free trial regardless of Stripe being enabled.
#
# --- LOCAL TESTING SETUP ---
# 1. Install Stripe CLI:   brew install stripe/stripe-cli/stripe
# 2. Authenticate:         make stripe-login
# 3. Copy test keys below from https://dashboard.stripe.com/test/apikeys
# 4. Start webhook tunnel: make stripe-listen
#    → it prints "Your webhook signing secret is whsec_test_..."
#    → paste that value into STRIPE_WEBHOOK_SECRET below and restart backend
# 5. Create test prices in https://dashboard.stripe.com/test/products
#    → copy the price_... IDs into STRIPE_PRICE_PREMIUM / STRIPE_PRICE_ENTERPRISE
# 6. Test card: 4242 4242 4242 4242 | Any future date | Any CVC
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# OPEN_SOURCE_MODE=false
