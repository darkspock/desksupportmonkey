# DSM Control — Production Environment
# Copy to /opt/dsmcontrol/.env and fill in real values

# Brand
BRAND_NAME=DSM Control
BRAND_SHORT_NAME=DSM Control
BRAND_SLUG=dsmcontrol
BRAND_LOGO_EXT=svg
BRAND_FAVICON_EXT=svg
BRAND_LOGIN_EXT=svg

# Database (isolated per brand)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dsmcontrol_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Environment
ENVIRONMENT=production
DEBUG=False

# Auth
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
MAGIC_LINK_EXPIRE_HOURS=24

# Celery / Redis (DB 3 — isolated from DSM prod DB 1 and staging DB 2)
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

# Email
SMTP_FROM_EMAIL=noreply@dsmcontrol.com
BREVO_API_KEY=

# S3 / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_REPORTS_BUCKET=dsmcontrol-reports
S3_SIGNED_URL_EXPIRY=3600

# Monitoring
SENTRY_DSN=

# Frontend
FRONTEND_URL=https://app.dsmcontrol.com
CORS_ORIGINS=https://app.dsmcontrol.com,https://www.dsmcontrol.com

# OAuth
GOOGLE_CLIENT_ID=559930264715-eoshcdj31tjg51ajonkv80jh3tog35r3.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=cde6455d-5cea-4f71-8b6e-45402f55d423
MICROSOFT_TENANT_ID=common

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
# STRIPE_WEBHOOK_SECRET=
