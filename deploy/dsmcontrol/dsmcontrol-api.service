[Unit]
Description=DSM Control API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dsmcontrol/app
EnvironmentFile=/opt/dsmcontrol/.env
Environment=PYTHONPATH=/opt/dsmcontrol/app/src
ExecStart=/root/.local/bin/uv run --python python3.13 uvicorn app:app --host 127.0.0.1 --port 8004
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
