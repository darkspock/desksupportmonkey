[Unit]
Description=DSM Control Celery Worker
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dsmcontrol/app
EnvironmentFile=/opt/dsmcontrol/.env
Environment=PYTHONPATH=/opt/dsmcontrol/app/src
ExecStart=/root/.local/bin/uv run --python python3.13 celery -A core.celery:celery_app worker -Q reports -l INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
