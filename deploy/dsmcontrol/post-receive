#!/bin/bash
set -e

echo "==> Deploying DSM Control..."

WORK_DIR="/opt/dsmcontrol/app"
SITE_DIR="/opt/dsmcontrol/web/site"
APP_DIR="/opt/dsmcontrol/web/app"

# Checkout latest code
git --work-tree="$WORK_DIR" --git-dir="/opt/dsmcontrol/repo.git" checkout -f

cd "$WORK_DIR"

# --- Backend ---
echo "==> Installing Python dependencies..."
cd "$WORK_DIR" && /root/.local/bin/uv sync --frozen 2>&1 || true

echo "==> Running database migrations..."
cd "$WORK_DIR" && PYTHONPATH=src /root/.local/bin/uv run alembic upgrade head 2>&1 || true

# --- Astro marketing site (sitedsm) ---
echo "==> Building Astro marketing site..."
cd "$WORK_DIR/web/sitedsm"
npm install 2>&1 || true
npm run build
mkdir -p "$SITE_DIR"
rm -rf "${SITE_DIR:?}"/*
cp -r dist/* "$SITE_DIR/"
echo "==> Astro site deployed to $SITE_DIR"

# --- React SPA ---
echo "==> Building React SPA..."
cd "$WORK_DIR/web/app"
npm install 2>&1 || true
export VITE_API_BASE_URL=https://api.dsmcontrol.com/api/v1
export VITE_WS_BASE_URL=wss://api.dsmcontrol.com
export VITE_GOOGLE_CLIENT_ID=559930264715-eoshcdj31tjg51ajonkv80jh3tog35r3.apps.googleusercontent.com
npx vite build
mkdir -p "$APP_DIR"
rm -rf "${APP_DIR:?}"/*
cp -r dist/* "$APP_DIR/"
echo "==> React SPA deployed to $APP_DIR"

# --- Restart services ---
echo "==> Restarting services..."
sudo systemctl restart dsmcontrol-api
sudo systemctl restart dsmcontrol-celery

echo "==> DSM Control deployment complete!"
