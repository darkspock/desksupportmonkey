# DeskSupportMonkey — Staging Environment
# Copy to /opt/dsm-staging/.env.staging on the server

# Database (separate from production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dsm_staging
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Environment
ENVIRONMENT=staging
DEBUG=False

# Auth
SECRET_KEY=change-me-staging-secret
ALGORITHM=HS256
MAGIC_LINK_EXPIRE_HOURS=24

# Celery / Redis (DB 2 to isolate from production which uses DB 1)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

# SMTP (Brevo for staging emails, or leave empty for console)
SMTP_FROM_EMAIL=noreply@desksupportmonkey.com
BREVO_API_KEY=

# S3 / MinIO (share production MinIO or use separate bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_REPORTS_BUCKET=dsm-staging-reports
S3_SIGNED_URL_EXPIRY=3600

# Monitoring (optional, separate Sentry project or same)
# SENTRY_DSN=

# Frontend — CORS open for local frontend dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://staging.desksupportmonkey.com

# Super Admin (auto-created on startup if set)
# SUPER_ADMIN_EMAIL=admin@desksupportmonkey.com
