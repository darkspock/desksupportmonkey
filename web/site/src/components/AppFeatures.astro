const colorMap: Record<string, { bg: string; text: string; bullet: string }> = {
  blue: { bg: 'bg-blue-100', text: 'text-blue-600', bullet: 'bg-blue-500' },
  emerald: { bg: 'bg-emerald-100', text: 'text-emerald-600', bullet: 'bg-emerald-500' },
  amber: { bg: 'bg-amber-100', text: 'text-amber-600', bullet: 'bg-amber-500' },
  purple: { bg: 'bg-purple-100', text: 'text-purple-600', bullet: 'bg-purple-500' },
  rose: { bg: 'bg-rose-100', text: 'text-rose-600', bullet: 'bg-rose-500' },
  cyan: { bg: 'bg-cyan-100', text: 'text-cyan-600', bullet: 'bg-cyan-500' },
  orange: { bg: 'bg-orange-100', text: 'text-orange-600', bullet: 'bg-orange-500' },
  indigo: { bg: 'bg-indigo-100', text: 'text-indigo-600', bullet: 'bg-indigo-500' },
  sky: { bg: 'bg-sky-100', text: 'text-sky-600', bullet: 'bg-sky-500' },
  fuchsia: { bg: 'bg-fuchsia-100', text: 'text-fuchsia-600', bullet: 'bg-fuchsia-500' },
