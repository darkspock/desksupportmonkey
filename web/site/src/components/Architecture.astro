---
const boundedContexts = [
  { name: 'auth_bc', desc: 'Authentication, magic links, users, roles', color: 'bg-blue-500' },
  { name: 'company_bc', desc: 'Multi-tenant company management, departments', color: 'bg-indigo-500' },
  { name: 'asset_bc', desc: 'IT asset inventory, categories, assignments', color: 'bg-emerald-500' },
  { name: 'request_bc', desc: 'Service requests, lifecycle, assignment', color: 'bg-amber-500' },
  { name: 'notification_bc', desc: 'Real-time notifications via WebSocket', color: 'bg-purple-500' },
  { name: 'report_bc', desc: 'Async report generation (Celery + S3)', color: 'bg-rose-500' },
];

const backendTech = ['Python 3.13', 'FastAPI', 'SQLAlchemy', 'Alembic', 'Celery', 'Redis'];
const frontendTech = ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS', 'TanStack React Query'];
const infraTech = ['PostgreSQL', 'Redis', 'MinIO (S3)'];
---

<section class="bg-slate-50 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Architecture</h2>
      <p class="mt-3 text-slate-600 max-w-2xl mx-auto">
        Domain-Driven Design with Clean Architecture, CQRS, and Hexagonal Architecture / Ports & Adapters.
      </p>
    </div>

    <!-- Bounded Contexts -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-16">
      {boundedContexts.map((bc) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class={`h-3 w-3 rounded-full ${bc.color}`}></span>
            <code class="text-sm font-semibold text-slate-900">{bc.name}</code>
          </div>
          <p class="text-sm text-slate-600">{bc.desc}</p>
        </div>
      ))}
    </div>

    <!-- Tech Stack -->
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Backend</h3>
        <div class="flex flex-wrap gap-2">
          {backendTech.map((tech) => (
            <span class="rounded-full bg-slate-900 px-3 py-1.5 text-xs font-medium text-white">{tech}</span>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Frontend</h3>
        <div class="flex flex-wrap gap-2">
          {frontendTech.map((tech) => (
            <span class="rounded-full bg-blue-600 px-3 py-1.5 text-xs font-medium text-white">{tech}</span>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Infrastructure</h3>
        <div class="flex flex-wrap gap-2">
          {infraTech.map((tech) => (
            <span class="rounded-full bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
