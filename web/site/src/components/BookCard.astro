---
interface Props {
  title: string;
  link: string;
  description: string;
  accent: string;
}

const { title, link, description, accent } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener"
  class="group block rounded-2xl border border-slate-200 bg-white p-8 shadow-sm hover:shadow-lg transition-all hover:-translate-y-0.5"
>
  <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-xl ${accent}`}>
    <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
    </svg>
  </div>
  <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>
  <span class="mt-5 inline-flex items-center text-sm font-medium text-blue-600 group-hover:text-blue-700">
    Learn more
    <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </span>
</a>
