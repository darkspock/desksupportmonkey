---
const boundedContexts = [
  { name: 'auth_bc', desc: 'Authentication, magic links, users, roles', color: 'bg-blue-500' },
  { name: 'company_bc', desc: 'Multi-tenant company management, departments', color: 'bg-indigo-500' },
  { name: 'asset_bc', desc: 'IT asset inventory, categories, assignments', color: 'bg-emerald-500' },
  { name: 'request_bc', desc: 'Service requests, lifecycle, assignment', color: 'bg-amber-500' },
  { name: 'notification_bc', desc: 'Real-time notifications via WebSocket', color: 'bg-purple-500' },
  { name: 'report_bc', desc: 'Async report generation (Celery + S3)', color: 'bg-rose-500' },
];

const backendTech = ['Python 3.13', 'FastAPI', 'SQLAlchemy', 'Alembic', 'Celery', 'Redis'];
const frontendTech = ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS', 'TanStack React Query'];
const infraTech = ['PostgreSQL', 'Redis', 'MinIO (S3)'];
---

<section class="bg-slate-900 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="inline-block rounded-full bg-blue-600/20 px-4 py-1.5 text-xs font-semibold text-blue-400 uppercase tracking-wider mb-4">
          100% AI-Generated
        </span>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">
          Built entirely with AI
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-300">
          Every line of code was generated by
          <strong class="text-white">Claude Code</strong> (Anthropic), guided by a human architect
          using <strong class="text-white">Spec-Driven Development</strong>.
        </p>
        <p class="mt-4 text-slate-400">
          No human-written code — every line was AI-generated, human-reviewed. The entire development
          pipeline uses 11 custom AI agents that handle requirements, design, implementation, and
          quality validation.
        </p>
        <p class="mt-4 text-slate-400">
          The architecture follows <strong class="text-white">Domain-Driven Design</strong> with Clean Architecture,
          <strong class="text-white">CQRS</strong>, and Hexagonal Architecture / Ports & Adapters —
          patterns documented in the <a href="/books" class="text-blue-400 hover:text-blue-300 underline underline-offset-2">companion books</a>.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/training"
            class="inline-flex items-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors"
          >
            Learn the methodology
          </a>
          <a
            href="/books"
            class="inline-flex items-center rounded-lg border border-slate-600 px-5 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-800 transition-colors"
          >
            Read the books
          </a>
          <a
            href="https://github.com/darkspock/desksupportmonkey"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center rounded-lg border border-slate-600 px-5 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-800 transition-colors"
          >
            View source code
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-700 bg-slate-800/50 p-8">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-6">Development Pipeline</h3>
        <div class="space-y-4">
          {[
            { step: '1', label: 'Product Discovery', desc: 'Define the problem and scope' },
            { step: '2', label: 'Epic', desc: 'Write structured requirements' },
            { step: '3', label: 'Validate', desc: 'Check completeness and consistency' },
            { step: '4', label: 'Slice', desc: 'Break into features' },
            { step: '5', label: 'Design', desc: 'Technical architecture' },
            { step: '6', label: 'Tasks', desc: 'Implementation checklist' },
            { step: '7', label: 'Implement', desc: 'AI generates code' },
            { step: '8', label: 'Review', desc: 'Quality validation' },
          ].map((item) => (
            <div class="flex items-start gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-600/20 text-xs font-bold text-blue-400">
                {item.step}
              </span>
              <div>
                <span class="text-sm font-semibold text-white">{item.label}</span>
                <span class="text-sm text-slate-400"> — {item.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Architecture: Bounded Contexts + Tech Stack -->
    <div class="mt-16">
      <h3 class="text-center text-sm font-semibold text-slate-400 uppercase tracking-wider mb-8">6 Bounded Contexts</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
        {boundedContexts.map((bc) => (
          <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-5">
            <div class="flex items-center gap-3 mb-2">
              <span class={`h-3 w-3 rounded-full ${bc.color}`}></span>
              <code class="text-sm font-semibold text-white">{bc.name}</code>
            </div>
            <p class="text-sm text-slate-400">{bc.desc}</p>
          </div>
        ))}
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        <div>
          <h4 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Backend</h4>
          <div class="flex flex-wrap gap-2">
            {backendTech.map((tech) => (
              <span class="rounded-full bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-200">{tech}</span>
            ))}
          </div>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Frontend</h4>
          <div class="flex flex-wrap gap-2">
            {frontendTech.map((tech) => (
              <span class="rounded-full bg-blue-600/30 px-3 py-1.5 text-xs font-medium text-blue-300">{tech}</span>
            ))}
          </div>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Infrastructure</h4>
          <div class="flex flex-wrap gap-2">
            {infraTech.map((tech) => (
              <span class="rounded-full bg-emerald-600/30 px-3 py-1.5 text-xs font-medium text-emerald-300">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
