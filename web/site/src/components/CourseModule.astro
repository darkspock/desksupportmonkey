---
interface Props {
  number: number;
  title: string;
  type: string;
}

const { number, title, type } = Astro.props;

const typeColors: Record<string, string> = {
  theory: 'bg-slate-100 text-slate-700',
  'demo + practice': 'bg-blue-100 text-blue-700',
  'hands-on': 'bg-emerald-100 text-emerald-700',
  workshop: 'bg-purple-100 text-purple-700',
  'live coding': 'bg-amber-100 text-amber-700',
};

const colorClass = typeColors[type] || typeColors['theory'];
---

<div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">
    {number}
  </span>
  <div class="min-w-0">
    <h4 class="text-sm font-semibold text-slate-900">{title}</h4>
    <span class={`mt-1.5 inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${colorClass}`}>
      {type}
    </span>
  </div>
</div>
