---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — DeskSupportMonkey" description="Get in touch with Juan Macias, the architect behind DeskSupportMonkey.">
  <div class="pt-32 pb-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Contact</h1>
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
          Get in touch — whether about the project, the books, or AI-assisted development training.
        </p>
      </div>

      <div class="mx-auto max-w-3xl">
        <!-- About the Author -->
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm mb-12">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">About the Author</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            <strong class="text-slate-900">Juan Macias</strong> is a software architect and author specializing in
            Domain-Driven Design, clean architecture, and AI-assisted development. He is the architect behind
            DeskSupportMonkey — an open-source platform built entirely with AI to demonstrate that production-grade
            software can be created through Spec-Driven Development.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Author of <a href="https://dddpython.com/" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700 font-medium">Domain-Driven Design with Python</a>
            and <a href="https://thebrokentelephone.com/" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700 font-medium">The Broken Telephone</a>,
            and creator of the <a href="/training" class="text-blue-600 hover:text-blue-700 font-medium">AI-Assisted Development course</a>.
          </p>
        </div>

        <!-- Contact Links -->
        <div class="grid gap-6 sm:grid-cols-2">
          <a
            href="https://x.com/juanmacias"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-5 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:shadow-lg transition-all hover:-translate-y-0.5"
          >
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-slate-900">
              <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">X / Twitter</h3>
              <p class="text-sm text-slate-500">@juanmacias</p>
            </div>
          </a>

          <a
            href="https://linkedin.com/in/juanmaciasvela"
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-5 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:shadow-lg transition-all hover:-translate-y-0.5"
          >
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-blue-700">
              <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">LinkedIn</h3>
              <p class="text-sm text-slate-500">Juan Macias Vela</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
