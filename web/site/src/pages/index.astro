---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NIS2Section from '../components/NIS2Section.astro';
import AppFeatures from '../components/AppFeatures.astro';
import AISummary from '../components/AISummary.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.desksupportmonkey.com';
---

<BaseLayout title="Desk Support Monkey — IT Support, Simplified">
  <Hero appUrl={appUrl} />
  <NIS2Section />
  <AppFeatures />
  <AISummary />
</BaseLayout>
