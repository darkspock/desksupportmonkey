---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AppFeatures from '../components/AppFeatures.astro';
import AISummary from '../components/AISummary.astro';
import Architecture from '../components/Architecture.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.desksupportmonkey.com';
---

<BaseLayout title="DeskSupportMonkey — IT Support, Simplified">
  <Hero appUrl={appUrl} />
  <AppFeatures />
  <AISummary />
  <Architecture />
</BaseLayout>
