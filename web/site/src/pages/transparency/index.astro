---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    href: '/transparency/team',
    icon: '👥',
    title: 'Team',
    description: 'Who is behind Desk Support Monkey. Real humans and AI-augmented roles explained.',
  },
  {
    href: '/transparency/business-model',
    icon: '💼',
    title: 'Business Model',
    description: 'How we make money, our pricing philosophy, and why we chose open source.',
  },
  {
    href: '/transparency/financials',
    icon: '📊',
    title: 'Financials',
    description: '12-month projections, costs, break-even, and our path to sustainability.',
  },
  {
    href: '/transparency/market',
    icon: '🌍',
    title: 'Market',
    description: 'Market sizing, NIS2 opportunity, Spain-first strategy, and EU expansion plan.',
  },
  {
    href: '/transparency/go-to-market',
    icon: '🚀',
    title: 'Go-to-Market',
    description: 'How we plan to reach customers — open source, build in public, and LinkedIn.',
  },
  {
    href: '/transparency/competitive',
    icon: '🔍',
    title: 'Competitive Analysis',
    description: 'How we compare to GLPI, Lansweeper, Snipe-IT, Freshservice, and others.',
  },
];
---

<BaseLayout title="Transparency — Desk Support Monkey" description="We build in public. Our team, business model, financials, market analysis, and strategy are all open.">
  <div class="pt-24 pb-20">
    <div class="mx-auto max-w-4xl px-6">

      <!-- Header -->
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700 mb-5">
          Building in public
        </div>
        <h1 class="text-4xl font-bold text-slate-900 tracking-tight sm:text-5xl">
          Full transparency
        </h1>
        <p class="mt-5 text-lg text-slate-600 max-w-2xl mx-auto">
          We believe the best way to build trust is to show our work. Our team, strategy, finances,
          and even the parts that aren't perfect yet — all of it is public.
        </p>
      </div>

      <!-- Sections grid -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((s) => (
          <a
            href={s.href}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md hover:border-blue-200 transition-all"
          >
            <div class="text-3xl mb-3">{s.icon}</div>
            <h2 class="text-lg font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">{s.title}</h2>
            <p class="mt-1.5 text-sm text-slate-500 leading-relaxed">{s.description}</p>
            <div class="mt-4 flex items-center gap-1 text-xs font-medium text-blue-600">
              Read more
              <svg class="h-3.5 w-3.5 translate-x-0 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Why transparency -->
      <div class="mt-14 rounded-2xl bg-slate-900 p-8 text-white">
        <h2 class="text-xl font-bold mb-3">Why we build in public</h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          The entire project — code, architecture, business model, financials, and go-to-market strategy — is on GitHub.
          Not just the code. All of it.
        </p>
        <p class="text-slate-300 text-sm leading-relaxed mb-5">
          We do this because the companies that will buy Desk Support Monkey are companies that understand the value
          of transparency and documentation. NIS2 compliance is about showing your work.
          We should do the same.
        </p>
        <a
          href="https://github.com/desksupportmonkey/desksupportmonkey"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-100 transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
          View on GitHub
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
