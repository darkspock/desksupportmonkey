---
import BaseLayout from '../../layouts/BaseLayout.astro';

const team = [
  {
    name: 'Juan Macias',
    role: 'Orchestrator',
    photo: null,
    linkedIn: 'https://www.linkedin.com/in/john-spock-macias/',
    bio: 'The only human at Desk Support Monkey. Over a decade in IT support and microinformatics — managing assets, handling incidents, fighting spreadsheets. Directs a team of AI agents to build and run the company. Running the public experiment: can 1 person + AI compete with a 50-person SaaS team?',
    isHuman: true,
    tag: 'Human',
  },
  {
    name: 'Aria Chen',
    role: 'CEO — AI Agent',
    photo: '/team/ceo.png',
    linkedIn: null,
    bio: 'Strategic leadership, product vision, and customer development. Handles NIS2 market positioning, pricing decisions, and go-to-market strategy. Produces market analysis, competitive research, and investor-facing materials under Orchestrator direction.',
    isHuman: false,
    tag: 'AI Agent',
  },
  {
    name: 'Marcus Webb',
    role: 'CTO — AI Agent',
    photo: '/team/cto.png',
    linkedIn: null,
    bio: 'Engineering architecture, code generation, and technical quality gates. Every line of code in Desk Support Monkey was written by this agent (Claude Code). Zero-bugs philosophy, DDD + CQRS architecture, non-negotiable quality standards.',
    isHuman: false,
    tag: 'AI Agent',
  },
  {
    name: 'Rafael Torres',
    role: 'Senior Engineer — AI Agent',
    photo: '/team/senior-engineer.png',
    linkedIn: null,
    bio: 'Full-stack execution: Python backend, React frontend, infrastructure, DevOps. Implements features from tasks.md specs. Owns the testing pipeline, integration tests, and CI quality gates. Works directly with the CTO agent on architecture decisions.',
    isHuman: false,
    tag: 'AI Agent',
  },
  {
    name: 'Elena Vasquez',
    role: 'Head of Growth — AI Agent',
    photo: '/team/head-of-growth.png',
    linkedIn: null,
    bio: 'Zero-budget distribution strategy. Produces LinkedIn content, NIS2 educational posts, SEO articles, podcast pitch scripts, and event talk proposals. Tracks what content generates signups, iterates based on data, no paid ads.',
    isHuman: false,
    tag: 'AI Agent',
  },
  {
    name: 'Sophie Laurent',
    role: 'Head of CS & Ops — AI Agent',
    photo: '/team/head-of-success.png',
    linkedIn: null,
    bio: 'Customer onboarding, support responses, documentation, and operations. Ensures customers get maximum value from the platform for NIS2 compliance. Monitors support SLAs and customer health indicators.',
    isHuman: false,
    tag: 'AI Agent',
  },
];
---

<BaseLayout title="Team — Desk Support Monkey" description="One human. A team of AI agents. This is what a 100% AI-managed company looks like.">
  <div class="pt-24 pb-20">
    <div class="mx-auto max-w-4xl px-6">

      <a href="/transparency" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 transition-colors mb-6">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Transparency
      </a>

      <h1 class="text-4xl font-bold text-slate-900 tracking-tight mb-3">The Team</h1>
      <p class="mt-2 text-lg text-slate-600 max-w-2xl mb-8">
        One human. Five AI agents. This is what a 100% AI-managed company looks like.
      </p>

      <!-- The experiment callout -->
      <div class="mb-10 rounded-2xl bg-slate-900 p-6 text-white">
        <div class="flex items-start gap-4">
          <div class="text-3xl shrink-0">🎼</div>
          <div>
            <h2 class="text-base font-bold mb-2">The public experiment</h2>
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              Desk Support Monkey is run by one human — the Orchestrator — directing a team of AI agents.
              Every line of code was written by AI. Every strategy document, financial projection, and marketing asset
              was produced by AI under explicit human direction.
            </p>
            <p class="text-slate-300 text-sm leading-relaxed">
              The question we are answering in real time: <strong class="text-white">Can a 1-person company with AI agents compete with a 50-person SaaS team?</strong>
              We believe the answer is yes. The numbers are public. Follow along.
            </p>
          </div>
        </div>
      </div>

      <!-- Team grid -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {team.map((member) => (
          <div class:list={[
            'rounded-2xl border p-6',
            member.isHuman
              ? 'border-blue-300 bg-blue-50 ring-2 ring-blue-200'
              : 'border-slate-200 bg-white shadow-sm'
          ]}>
            <div class="flex items-start gap-4">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={member.name}
                  class="h-16 w-16 rounded-xl object-cover shrink-0"
                />
              ) : (
                <div class="h-16 w-16 rounded-xl bg-blue-600 flex items-center justify-center shrink-0">
                  <span class="text-2xl font-bold text-white">
                    {member.name.split(' ').map((n: string) => n[0]).join('')}
                  </span>
                </div>
              )}
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-bold text-slate-900">{member.name}</h2>
                  <span class:list={[
                    'rounded-full px-2 py-0.5 text-xs font-medium shrink-0',
                    member.isHuman
                      ? 'bg-blue-600 text-white'
                      : 'bg-slate-800 text-slate-200'
                  ]}>
                    {member.tag}
                  </span>
                </div>
                <p class="text-sm font-medium text-slate-500 mt-0.5">{member.role}</p>
                {member.linkedIn && (
                  <a
                    href={member.linkedIn}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 mt-1 text-xs text-blue-600 hover:text-blue-700"
                  >
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                  </a>
                )}
              </div>
            </div>
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>

      <!-- Advisor model -->
      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 mb-1">Advisors — not employees</h2>
        <p class="text-sm text-slate-600 mb-4">
          When human expertise is needed, we bring in advisors. No full-time salaries, no management overhead. Human judgment, on demand.
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 text-sm">
          {[
            { title: 'Domain advisors', desc: 'NIS2 compliance specialists, IT security experts, CISOs' },
            { title: 'Technical advisors', desc: 'Architecture review, external audits, specialized engineering' },
            { title: 'Commercial advisors', desc: 'Senior sales, channel partnerships, enterprise relationships' },
          ].map((a) => (
            <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
              <div class="font-semibold text-slate-800 mb-1">{a.title}</div>
              <div class="text-slate-500 text-xs">{a.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Future -->
      <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm">
        <h3 class="font-semibold text-amber-900 mb-1">Will there ever be real employees?</h3>
        <p class="text-amber-800 leading-relaxed">
          Unknown. We follow the evidence. If AI agents can handle all functions, we may never hire.
          If there are roles where human judgment is irreplaceable — enterprise relationships, regulatory representation,
          specific domain expertise — we will bring in those humans. The decision will be driven by results, not by convention.
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
