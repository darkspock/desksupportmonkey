---
import type { Lang } from '../i18n/translations';
import { comparisons } from '../data/comparisons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'es' ? '' : '/en';

const l = {
  es: {
    title: 'DSM Control vs alternativas',
    subtitle: 'Compara DSM Control con otras herramientas de gestion de activos TIC. Descubre cual se adapta mejor a tus necesidades.',
    cta: 'Ver comparativa',
    back: 'Volver al inicio',
  },
  en: {
    title: 'DSM Control vs alternatives',
    subtitle: 'Compare DSM Control with other IT asset management tools. Find out which one fits your needs best.',
    cta: 'See comparison',
    back: 'Back to home',
  },
};
const t = l[lang];
---

<section class="bg-white pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="mx-auto max-w-4xl px-6">
    <a href={prefix + '/'} class="inline-flex items-center gap-1 text-sm text-teal-600 hover:underline mb-8">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      {t.back}
    </a>
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl lg:text-5xl">{t.title}</h1>
    <p class="mt-4 text-lg text-slate-600 max-w-2xl">{t.subtitle}</p>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {comparisons.map((comp) => (
        <a href={`${prefix}/vs/${comp.slug}`} class="group rounded-2xl border border-slate-200 bg-white p-6 hover:border-teal-300 hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-4">
            <div class:list={['h-10 w-10 rounded-xl flex items-center justify-center text-sm font-bold', comp.logo_color]}>
              {comp.competitor.charAt(0)}
            </div>
            <div>
              <p class="text-xs text-slate-500">DSM Control vs</p>
              <p class="font-semibold text-slate-900">{comp.competitor}</p>
            </div>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed">{comp.subtitle[lang]}</p>
          <p class="mt-4 text-sm font-medium text-teal-600 group-hover:underline">{t.cta} &rarr;</p>
        </a>
      ))}
    </div>
  </div>
</section>
