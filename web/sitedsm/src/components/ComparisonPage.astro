---
import type { Lang } from '../i18n/translations';
import type { ComparisonData } from '../data/comparisons';

interface Props {
  lang: Lang;
  data: ComparisonData;
}

const { lang, data } = Astro.props;
const prefix = lang === 'es' ? '' : '/en';
const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.dsmcontrol.com';

const l = {
  es: {
    feature: 'Funcionalidad',
    pricing_title: 'Comparativa de precios',
    verdict_title: 'Veredicto',
    best_for: 'Mejor para',
    cta_title: 'Prueba DSM Control gratis',
    cta_subtitle: '15 dias gratis. Sin tarjeta de credito. Sin coste por usuario.',
    cta_demo: 'Solicitar Demo',
    cta_start: 'Empieza Gratis',
    back: 'Ver todas las comparativas',
  },
  en: {
    feature: 'Feature',
    pricing_title: 'Pricing comparison',
    verdict_title: 'Verdict',
    best_for: 'Best for',
    cta_title: 'Try DSM Control for free',
    cta_subtitle: '15 days free. No credit card. No per-user fees.',
    cta_demo: 'Request Demo',
    cta_start: 'Start Free',
    back: 'See all comparisons',
  },
};
const t = l[lang];
---

<!-- Hero -->
<section class="bg-white pt-28 pb-16 sm:pt-36 sm:pb-20">
  <div class="mx-auto max-w-4xl px-6">
    <a href={prefix + '/vs'} class="inline-flex items-center gap-1 text-sm text-teal-600 hover:underline mb-8">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      {t.back}
    </a>
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl lg:text-5xl">{data.headline[lang]}</h1>
    <p class="mt-4 text-lg text-slate-600">{data.subtitle[lang]}</p>
  </div>
</section>

<!-- Intro -->
<section class="pb-16">
  <div class="mx-auto max-w-4xl px-6">
    <p class="text-slate-700 leading-relaxed text-lg">{data.intro[lang]}</p>
  </div>
</section>

<!-- Summary cards -->
<section class="pb-16">
  <div class="mx-auto max-w-4xl px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border-2 border-teal-200 bg-teal-50/30 p-6">
        <div class="flex items-center gap-2 mb-4">
          <svg class="h-6 w-6 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <span class="text-lg font-bold text-slate-900">DSM Control</span>
        </div>
        <p class="text-sm text-slate-700 leading-relaxed">{data.dsm_summary[lang]}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class:list={['h-6 w-6 rounded flex items-center justify-center text-xs font-bold', data.logo_color]}>
            {data.competitor.charAt(0)}
          </div>
          <span class="text-lg font-bold text-slate-900">{data.competitor}</span>
        </div>
        <p class="text-sm text-slate-700 leading-relaxed">{data.competitor_summary[lang]}</p>
      </div>
    </div>
  </div>
</section>

<!-- Feature comparison table -->
<section class="bg-slate-50 py-16">
  <div class="mx-auto max-w-4xl px-6">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <table class="w-full">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900">{t.feature}</th>
            <th class="px-6 py-4 text-center text-sm font-semibold text-teal-600 w-32">DSM Control</th>
            <th class="px-6 py-4 text-center text-sm font-semibold text-slate-600 w-32">{data.competitor}</th>
          </tr>
        </thead>
        <tbody>
          {data.features.map((f, i) => (
            <tr class:list={['border-b border-slate-100', i % 2 === 0 ? '' : 'bg-slate-50/50']}>
              <td class="px-6 py-3.5 text-sm text-slate-700">{f.name[lang]}</td>
              <td class="px-6 py-3.5 text-center">
                {f.dsm === true ? (
                  <svg class="mx-auto h-5 w-5 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                ) : f.dsm === false ? (
                  <svg class="mx-auto h-5 w-5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                ) : (
                  <span class="text-sm">{f.dsm}</span>
                )}
              </td>
              <td class="px-6 py-3.5 text-center">
                {f.competitor === true ? (
                  <svg class="mx-auto h-5 w-5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                ) : f.competitor === false ? (
                  <svg class="mx-auto h-5 w-5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                ) : (
                  <span class="text-sm">{f.competitor}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="py-16">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="text-2xl font-bold text-slate-900 mb-8">{t.pricing_title}</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border-2 border-teal-200 bg-teal-50/30 p-6">
        <h3 class="font-semibold text-slate-900 mb-3">DSM Control</h3>
        <p class="text-sm text-slate-700 leading-relaxed">{data.pricing_dsm[lang]}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-6">
        <h3 class="font-semibold text-slate-900 mb-3">{data.competitor}</h3>
        <p class="text-sm text-slate-700 leading-relaxed">{data.pricing_competitor[lang]}</p>
      </div>
    </div>
  </div>
</section>

<!-- Verdict -->
<section class="bg-slate-50 py-16">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">{t.verdict_title}</h2>
    <p class="text-slate-700 leading-relaxed text-lg mb-10">{data.verdict[lang]}</p>
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-teal-200 bg-white p-6">
        <p class="text-xs font-bold text-teal-600 uppercase tracking-wider mb-2">{t.best_for}: DSM Control</p>
        <p class="text-sm text-slate-700">{data.best_for_dsm[lang]}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">{t.best_for}: {data.competitor}</p>
        <p class="text-sm text-slate-700">{data.best_for_competitor[lang]}</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-navy-900 py-20">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-3xl font-bold text-white">{t.cta_title}</h2>
    <p class="mt-4 text-slate-400">{t.cta_subtitle}</p>
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a href="mailto:sales@dsmcontrol.com" class="inline-flex items-center rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-teal-700 transition-all">
        {t.cta_demo}
      </a>
      <a href={`${appUrl}/auth/register`} class="inline-flex items-center rounded-xl border border-slate-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-slate-800 transition-all">
        {t.cta_start}
      </a>
    </div>
  </div>
</section>
