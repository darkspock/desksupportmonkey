---
import type { Lang } from '../i18n/translations';
import type { ComplianceData } from '../data/compliance';

interface Props {
  lang: Lang;
  data: ComplianceData;
}

const { lang, data } = Astro.props;
const prefix = lang === 'es' ? '' : '/en';
const ctaLabel = lang === 'es' ? 'Solicitar Demo' : 'Request Demo';
const ctaStart = lang === 'es' ? 'Empieza gratis 15 dias' : 'Start free for 15 days';
const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.dsmcontrol.com';
const withoutLabel = lang === 'es' ? 'Sin DSM Control' : 'Without DSM Control';
const withLabel = lang === 'es' ? 'Con DSM Control' : 'With DSM Control';
const otherPages = [
  { slug: 'nis2', label: 'NIS2' },
  { slug: 'iso27001', label: 'ISO 27001' },
  { slug: 'cra', label: 'CRA' },
  { slug: 'dora', label: 'DORA' },
].filter(p => p.slug !== data.slug);
const compliancePath = lang === 'es' ? '/compliance' : '/en/compliance';
---

<!-- HERO -->
<section class="relative overflow-hidden bg-white pt-28 pb-16 sm:pt-36 sm:pb-20">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-teal-50)_0%,_transparent_50%)]"></div>
  <div class="relative mx-auto max-w-4xl px-6">
    <div class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-4 py-1.5 text-sm font-medium text-teal-700 mb-6">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
      </svg>
      {data.badge[lang]}
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">{data.headline[lang]}</h1>
    <p class="mt-6 text-lg text-slate-600 leading-relaxed">{data.subtitle[lang]}</p>
    <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
      <a href="mailto:sales@dsmcontrol.com" class="inline-flex items-center rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700 transition-all">
        {ctaLabel}
      </a>
      <a href={`${appUrl}/auth/register`} class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-7 py-3.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all">
        {ctaStart}
      </a>
    </div>
  </div>
</section>

<!-- WHAT IS IT -->
<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{data.what.title[lang]}</h2>
    <p class="mt-4 text-slate-600 leading-relaxed">{data.what.text[lang]}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <!-- Who -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">{data.who.title[lang]}</h3>
        <ul class="space-y-3">
          {data.who.items.map(item => (
            <li class="flex gap-3 text-sm text-slate-600">
              <svg class="h-5 w-5 text-teal-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span>{item[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
      <!-- Penalties -->
      <div class="rounded-2xl border border-red-100 bg-red-50/50 p-6">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">{data.penalties.title[lang]}</h3>
        <ul class="space-y-3">
          {data.penalties.items.map(item => (
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="h-5 w-5 text-red-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
              <span>{item[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- REQUIREMENTS MAPPING -->
<section class="bg-slate-50 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{data.mappings.title[lang]}</h2>
    <p class="mt-4 text-slate-600 leading-relaxed max-w-3xl">{data.mappings.subtitle[lang]}</p>

    <div class="mt-10 space-y-6">
      {data.mappings.items.map(item => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-start gap-4">
            <div class="sm:w-1/3">
              <div class="text-xs font-semibold text-teal-600 uppercase tracking-wider mb-1">{lang === 'es' ? 'Requisito' : 'Requirement'}</div>
              <div class="text-sm font-semibold text-slate-900">{item.requirement[lang]}</div>
              <p class="mt-1 text-xs text-slate-500">{item.meaning[lang]}</p>
            </div>
            <div class="sm:w-2/3 sm:border-l sm:border-slate-100 sm:pl-6">
              <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">{item.feature[lang]}</div>
              <p class="text-sm text-slate-600 leading-relaxed">{item.how[lang]}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- AUDITOR QUESTIONS -->
<section class="bg-navy-900 py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{data.auditor.title[lang]}</h2>
    <div class="mt-10 space-y-6">
      {data.auditor.questions.map(q => (
        <div class="rounded-2xl border border-slate-700 bg-slate-800/50 p-6 sm:p-8">
          <p class="text-base font-medium text-white italic mb-6">"{q.question[lang]}"</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-red-900/20 border border-red-800/30 p-4">
              <div class="text-xs font-semibold text-red-400 uppercase tracking-wider mb-2">{withoutLabel}</div>
              <p class="text-sm text-slate-300">{q.without[lang]}</p>
            </div>
            <div class="rounded-xl bg-teal-900/20 border border-teal-800/30 p-4">
              <div class="text-xs font-semibold text-teal-400 uppercase tracking-wider mb-2">{withLabel}</div>
              <p class="text-sm text-white">{q.with[lang]}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GAPS -->
<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{data.gaps.title[lang]}</h2>
    <div class="mt-10 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="text-left py-3 px-4 font-semibold text-slate-900">{lang === 'es' ? 'Gap' : 'Gap'}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900">{lang === 'es' ? 'Riesgo' : 'Risk'}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900">{lang === 'es' ? 'DSM Control' : 'DSM Control'}</th>
          </tr>
        </thead>
        <tbody>
          {data.gaps.items.map(item => (
            <tr class="border-b border-slate-100">
              <td class="py-3 px-4 text-slate-700 font-medium">{item.gap[lang]}</td>
              <td class="py-3 px-4 text-red-600">{item.risk[lang]}</td>
              <td class="py-3 px-4 text-slate-600">{item.solution[lang]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- TIMELINE (optional) -->
{data.timeline && (
  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{data.timeline.title[lang]}</h2>
      <div class="mt-10 relative">
        <div class="absolute left-4 top-0 bottom-0 w-px bg-teal-200"></div>
        <div class="space-y-8">
          {data.timeline.items.map(item => (
            <div class="relative pl-12">
              <div class="absolute left-2 top-1 h-5 w-5 rounded-full border-2 border-teal-500 bg-white"></div>
              <div class="text-sm font-bold text-teal-700">{item.date}</div>
              <p class="mt-1 text-sm text-slate-600">{item.event[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<!-- SUMMARY -->
<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <div class="rounded-2xl bg-teal-50 border border-teal-100 p-8 sm:p-10">
      <h2 class="text-2xl font-bold text-slate-900">{data.summary.title[lang]}</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">{data.summary.text[lang]}</p>
    </div>
  </div>
</section>

<!-- OTHER COMPLIANCE PAGES -->
<section class="border-t border-slate-200 py-12">
  <div class="mx-auto max-w-4xl px-6">
    <h3 class="text-center text-lg font-semibold text-slate-900 mb-6">
      {lang === 'es' ? 'Tambien preparado para' : 'Also ready for'}
    </h3>
    <div class="flex justify-center gap-4">
      {otherPages.map(p => (
        <a
          href={`${compliancePath}/${p.slug}`}
          class="rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-teal-200 transition-all"
        >
          {p.label}
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="bg-navy-900 py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">
      {lang === 'es' ? 'Empieza a cumplir esta semana' : 'Start complying this week'}
    </h2>
    <p class="mt-4 text-slate-400">
      {lang === 'es' ? 'Sin instalacion. Sin coste por usuario. 15 dias gratis.' : 'No installation. No per-user fees. Free for 15 days.'}
    </p>
    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a href="mailto:sales@dsmcontrol.com" class="inline-flex items-center rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700 transition-all">
        {ctaLabel}
      </a>
      <a href={`${appUrl}/auth/register`} class="inline-flex items-center rounded-xl border border-slate-600 bg-transparent px-7 py-3.5 text-sm font-semibold text-white hover:bg-slate-800 transition-all">
        {ctaStart}
      </a>
    </div>
  </div>
</section>
