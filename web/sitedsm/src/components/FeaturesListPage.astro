---
import type { Lang, Translations } from '../i18n/translations';
import { featureCategories } from '../data/featureList';

interface Props {
  appUrl: string;
  lang: Lang;
  t: Translations;
}

const { appUrl, lang, t } = Astro.props;

const totalFeatures = featureCategories.reduce((sum, cat) => sum + cat.features.length, 0);
---

<div class="pt-28 pb-20">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 text-center">
    <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">{t.featurelist.title}</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600">{t.featurelist.subtitle}</p>
    <p class="mt-4 text-sm font-semibold text-teal-700">{totalFeatures} {t.featurelist.count_features}</p>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-6xl px-6 mt-16">
    {featureCategories.map((category) => (
      <div class="mb-16" id={category.id}>
        <div class="flex items-center gap-3 mb-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={category.icon} />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900">{category.name[lang]}</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {category.features.map((feature) => (
            <div class="rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300 hover:shadow-sm transition-all">
              <h3 class="text-sm font-semibold text-slate-900">{feature.name[lang]}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{feature.desc[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- CTA -->
  <section class="bg-navy-900 py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white">{t.featurelist.cta_title}</h2>
      <p class="mt-4 text-slate-400">{t.featurelist.cta_subtitle}</p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="mailto:sales@dsmcontrol.com" class="inline-flex items-center rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700 transition-all">
          {t.cta.btn_demo}
        </a>
        <a href={`${appUrl}/auth/register`} class="inline-flex items-center rounded-xl border border-slate-600 bg-transparent px-7 py-3.5 text-sm font-semibold text-white hover:bg-slate-800 transition-all">
          {t.cta.btn_start}
        </a>
      </div>
    </div>
  </section>
</div>
