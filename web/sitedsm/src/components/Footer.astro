---
import type { Lang, Translations } from '../i18n/translations';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
const prefix = lang === 'es' ? '' : '/en';
const featuresPath = lang === 'es' ? '/funcionalidades' : '/en/features';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <svg class="h-5 w-5 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <span class="font-semibold text-slate-900">DSM Control</span>
        </div>
        <p class="text-sm text-slate-500">Plan Zeta Tech S.L.</p>
        <p class="text-sm text-slate-500 mt-1">{t.footer.hecho_en}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-slate-900 mb-3">{t.footer.producto}</h4>
        <ul class="space-y-2 text-sm text-slate-500">
          <li><a href={featuresPath} class="hover:text-slate-700 transition-colors">{t.footer.funcionalidades}</a></li>
          <li><a href={prefix + '/#pricing'} class="hover:text-slate-700 transition-colors">{t.footer.pricing}</a></li>
          <li><a href={prefix + '/#sectores'} class="hover:text-slate-700 transition-colors">{t.footer.sectores}</a></li>
          <li><a href="https://desksupportmonkey.com/opensource" class="hover:text-slate-700 transition-colors" target="_blank" rel="noopener">{t.footer.opensource}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-slate-900 mb-3">{t.footer.compliance}</h4>
        <ul class="space-y-2 text-sm text-slate-500">
          <li><a href={prefix + '/compliance/nis2'} class="hover:text-slate-700 transition-colors">NIS2</a></li>
          <li><a href={prefix + '/compliance/iso27001'} class="hover:text-slate-700 transition-colors">ISO 27001</a></li>
          <li><a href={prefix + '/compliance/cra'} class="hover:text-slate-700 transition-colors">CRA</a></li>
          <li><a href={prefix + '/#compliance'} class="hover:text-slate-700 transition-colors">{t.footer.seguridad}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-slate-900 mb-3">{t.footer.contacto}</h4>
        <ul class="space-y-2 text-sm text-slate-500">
          <li><a href="mailto:sales@dsmcontrol.com" class="hover:text-slate-700 transition-colors">{t.footer.solicitar_demo}</a></li>
          <li><a href="mailto:sales@dsmcontrol.com" class="hover:text-slate-700 transition-colors">sales@dsmcontrol.com</a></li>
          <li><a href="https://linkedin.com/in/juanmaciasvela" class="hover:text-slate-700 transition-colors" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-slate-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex gap-4">
        <a href={prefix + '/privacy'} class="hover:text-slate-600 transition-colors">{t.footer.privacidad}</a>
        <a href={prefix + '/terms'} class="hover:text-slate-600 transition-colors">{t.footer.terminos}</a>
        <a href={prefix + '/cookies'} class="hover:text-slate-600 transition-colors">{t.footer.cookies}</a>
      </div>
      <p>&copy; {year} Plan Zeta Tech S.L. {t.footer.derechos}</p>
    </div>
  </div>
</footer>
