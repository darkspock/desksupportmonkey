---
import type { Lang, Translations } from '../i18n/translations';

interface Props {
  appUrl: string;
  lang: Lang;
  t: Translations;
}

const { appUrl, lang, t } = Astro.props;
const altLang = lang === 'es' ? 'en' : 'es';
const altPath = lang === 'es' ? '/en' : '/';
const altLabel = lang === 'es' ? 'EN' : 'ES';
const prefix = lang === 'es' ? '' : '/en';
const featuresPath = lang === 'es' ? '/funcionalidades' : '/en/features';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href={prefix + '/'} class="flex items-center gap-2">
      <svg class="h-7 w-7 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
      </svg>
      <span class="text-lg font-bold text-slate-900">DSM Control</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      <!-- Producto dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">
          {t.nav.producto}
          <svg class="h-3.5 w-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute left-0 top-full mt-1 hidden group-hover:block w-48 rounded-xl border border-slate-200 bg-white py-1.5 shadow-lg">
          <a href={featuresPath} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">{t.nav.funcionalidades}</a>
          <a href={prefix + '/vs'} class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">{t.nav.comparativas}</a>
        </div>
      </div>
      <a href={prefix + '/#compliance'} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">{t.nav.compliance}</a>
      <a href={prefix + '/#sectores'} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">{t.nav.sectores}</a>
      <a href={prefix + '/#pricing'} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">{t.nav.pricing}</a>
      <a href="mailto:sales@dsmcontrol.com" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors">{t.nav.contacto}</a>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Language switcher -->
      <a
        href={altPath}
        class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors"
        title={altLang === 'en' ? 'Switch to English' : 'Cambiar a Espanol'}
        onclick="sessionStorage.setItem('dsm-lang-chosen', this.textContent.trim().toLowerCase())"
      >
        {altLabel}
      </a>

      <a
        href={`${appUrl}/auth/login`}
        class="rounded-lg px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 transition-colors hidden sm:inline-flex"
      >
        {t.nav.acceder}
      </a>
      <a
        href="mailto:sales@dsmcontrol.com"
        class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700 transition-colors"
      >
        {t.nav.solicitar_demo}
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden ml-1 rounded-lg p-2 text-slate-600 hover:bg-slate-100 transition-colors"
        aria-label={t.nav.abrir_menu}
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-6 pb-4">
    <div class="py-1 text-xs font-semibold uppercase tracking-wider text-slate-400 mt-3">{t.nav.producto}</div>
    <a href={featuresPath} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.funcionalidades}</a>
    <a href={prefix + '/vs'} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.comparativas}</a>
    <div class="py-1 text-xs font-semibold uppercase tracking-wider text-slate-400 mt-3"></div>
    <a href={prefix + '/#compliance'} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.compliance}</a>
    <a href={prefix + '/#sectores'} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.sectores}</a>
    <a href={prefix + '/#pricing'} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.pricing}</a>
    <a href="mailto:sales@dsmcontrol.com" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.contacto}</a>
    <div class="mt-3 border-t border-slate-100 pt-3">
      <a href={appUrl + '/auth/login'} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100">{t.nav.acceder}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
