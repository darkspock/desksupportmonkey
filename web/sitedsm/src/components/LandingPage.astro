---
import type { Lang, Translations } from '../i18n/translations';

interface Props {
  lang: Lang;
  t: Translations;
}

const { lang, t } = Astro.props;
const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.dsmcontrol.com';
const prefix = lang === 'es' ? '' : '/en';
const featuresPath = lang === 'es' ? '/funcionalidades' : '/en/features';
---

<!-- ============================================ -->
<!-- HERO                                         -->
<!-- ============================================ -->
<section class="relative overflow-hidden bg-white pt-28 pb-16 sm:pt-36 sm:pb-24">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-teal-50)_0%,_transparent_50%)]"></div>
  <div class="relative mx-auto max-w-6xl px-6 text-center">
    <div class="mx-auto max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-4 py-1.5 text-sm font-medium text-teal-700 mb-6">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        {t.hero.badge}
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        {t.hero.title_1}<br />
        <span class="text-teal-600">{t.hero.title_2}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 leading-relaxed">
        {t.hero.subtitle}
      </p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="mailto:sales@dsmcontrol.com"
          class="inline-flex items-center justify-center rounded-xl bg-teal-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700 transition-all hover:shadow-teal-600/30"
        >
          {t.hero.cta_demo}
          <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href={prefix + '/#pricing'}
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-7 py-3.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all"
        >
          {t.hero.cta_pricing}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- TRUST BAR                                    -->
<!-- ============================================ -->
<section class="border-y border-slate-100 bg-slate-50 py-6">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-sm font-medium text-slate-500">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {t.trust.nis2}
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {t.trust.rgpd}
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {t.trust.eu}
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-teal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {t.trust.opensource}
      </div>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- PROBLEM                                      -->
<!-- ============================================ -->
<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl max-w-3xl mx-auto">{t.problem.title}</h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      <!-- Card 1 -->
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-red-50 text-red-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 0v1.5c0 .621-.504 1.125-1.125 1.125" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900">{t.problem.card1_title}</h3>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">{t.problem.card1_text}</p>
      </div>
      <!-- Card 2 -->
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900">{t.problem.card2_title}</h3>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">{t.problem.card2_text}</p>
      </div>
      <!-- Card 3 -->
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-2.04a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 00-6.364 6.364L5.25 9.879" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-900">{t.problem.card3_title}</h3>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">{t.problem.card3_text}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- LIFECYCLE                                    -->
<!-- ============================================ -->
<section id="producto" class="bg-slate-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">{t.lifecycle.title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-center text-slate-600">{t.lifecycle.subtitle}</p>

    <div class="mt-16 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
      {[
        { name: t.lifecycle.step1_name, desc: t.lifecycle.step1_desc, icon: 'M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z' },
        { name: t.lifecycle.step2_name, desc: t.lifecycle.step2_desc, icon: 'M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z' },
        { name: t.lifecycle.step3_name, desc: t.lifecycle.step3_desc, icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z' },
        { name: t.lifecycle.step4_name, desc: t.lifecycle.step4_desc, icon: 'M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z' },
        { name: t.lifecycle.step5_name, desc: t.lifecycle.step5_desc, icon: 'M11.42 15.17l-5.58 3.61.15-6.5L1.27 7.11l6.45-.99L11.42.6l3.7 5.52 6.45.99-4.72 5.17.15 6.5z' },
        { name: t.lifecycle.step6_name, desc: t.lifecycle.step6_desc, icon: 'M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z' },
      ].map((step, i) => (
        <div class="flex flex-col items-center text-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-50 text-teal-600 mb-4">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={step.icon} />
            </svg>
          </div>
          <div class="text-xs font-bold text-teal-600 mb-1">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="text-sm font-semibold text-slate-900">{step.name}</h3>
          <p class="mt-1 text-xs text-slate-500">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- FEATURES GRID                                -->
<!-- ============================================ -->
<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">{t.features.title}</h2>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { title: t.features.f1_title, desc: t.features.f1_desc, icon: 'M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-1.243 1.007-2.25 2.25-2.25h13.5' },
        { title: t.features.f2_title, desc: t.features.f2_desc, icon: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-2.04a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 00-6.364 6.364L5.25 9.879' },
        { title: t.features.f3_title, desc: t.features.f3_desc, icon: 'M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z' },
        { title: t.features.f4_title, desc: t.features.f4_desc, icon: 'M11.42 15.17l-5.58 3.61.15-6.5L1.27 7.11l6.45-.99L11.42.6l3.7 5.52 6.45.99-4.72 5.17.15 6.5z' },
        { title: t.features.f5_title, desc: t.features.f5_desc, icon: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0H6.75m11.25 0h2.625c.621 0 1.125-.504 1.125-1.125v-4.875c0-.621-.504-1.125-1.125-1.125H18M7.5 14.25v-5.625m0 0L12 3.375m-4.5 5.25h9' },
        { title: t.features.f6_title, desc: t.features.f6_desc, icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z' },
        { title: t.features.f7_title, desc: t.features.f7_desc, icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
        { title: t.features.f8_title, desc: t.features.f8_desc, icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z' },
        { title: t.features.f9_title, desc: t.features.f9_desc, icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5' },
      ].map((feat) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={feat.icon} />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900">{feat.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{feat.desc}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 text-center">
      <a href={featuresPath} class="inline-flex items-center gap-2 rounded-xl border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        {t.features.ver_todas}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- COMPLIANCE                                   -->
<!-- ============================================ -->
<section id="compliance" class="bg-navy-900 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-white sm:text-4xl">{t.compliance.title}</h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {[
        { q: t.compliance.q1_question, a: t.compliance.q1_answer, icon: 'M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-1.243 1.007-2.25 2.25-2.25h13.5' },
        { q: t.compliance.q2_question, a: t.compliance.q2_answer, icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z' },
        { q: t.compliance.q3_question, a: t.compliance.q3_answer, icon: 'M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z' },
      ].map((card) => (
        <div class="rounded-2xl border border-slate-700 bg-slate-800/50 p-8">
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-teal-600/20 text-teal-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
            </svg>
          </div>
          <p class="text-sm font-medium text-slate-400 italic mb-3">"{card.q}"</p>
          <p class="text-sm text-white font-medium leading-relaxed">{card.a}</p>
        </div>
      ))}
    </div>
    <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-slate-400">{t.compliance.subtitle}</p>
  </div>
</section>

<!-- ============================================ -->
<!-- SECTORS                                      -->
<!-- ============================================ -->
<section id="sectores" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center text-3xl font-bold text-slate-900 sm:text-4xl">{t.sectors.title}</h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-2">
      {[
