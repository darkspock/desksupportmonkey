---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang, Translations } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  t: Translations;
}

const { title, description, lang, t } = Astro.props;
const meta = description || (lang === 'es'
  ? 'Control total de tus activos TIC — gestion del ciclo de vida completo con trazabilidad NIS2, DORA y CRA.'
  : 'Total control over your IT assets — complete lifecycle management with NIS2, DORA, and CRA audit trail.');
const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.dsmcontrol.com';
const altLang = lang === 'es' ? 'en' : 'es';
const altPath = lang === 'es' ? '/en' : '/';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={meta} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={meta} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={meta} />
  <link rel="alternate" hreflang={altLang} href={altPath} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body class="bg-white text-slate-800 antialiased font-sans">
  <Header appUrl={appUrl} lang={lang} t={t} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} t={t} />

  <!-- Language detection: redirect to /en if browser language is not Spanish -->
  {lang === 'es' && (
    <script is:inline>
      (function() {
        if (sessionStorage.getItem('dsm-lang-chosen')) return;
        const lang = navigator.language || navigator.userLanguage || '';
        if (!lang.startsWith('es')) {
          sessionStorage.setItem('dsm-lang-chosen', 'en');
          window.location.href = '/en';
        } else {
          sessionStorage.setItem('dsm-lang-chosen', 'es');
        }
      })();
    </script>
  )}
</body>
</html>
