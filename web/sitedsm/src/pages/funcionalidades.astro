---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturesListPage from '../components/FeaturesListPage.astro';
import { translations } from '../i18n/translations';

const lang = 'es';
const t = translations[lang];
---

<BaseLayout title="Todas las funcionalidades — DSM Control" lang={lang} t={t}>
  <FeaturesListPage lang={lang} t={t} appUrl={import.meta.env.PUBLIC_APP_URL ?? 'https://app.dsmcontrol.com'} />
</BaseLayout>
